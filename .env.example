# Supabase service-role key (SERVER ONLY — never expose with NEXT_PUBLIC).
# Settings → API → service_role. Used by the booking API + reminder cron.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — sign up at https://resend.com, create an API key (starts with re_).
RESEND_API_KEY=re_HmHqdAbG_Lj23gRRty8oMvXQE3WsqZt8V
# Verified sender. Use onboarding@resend.dev until your domain is verified.
RESEND_FROM_EMAIL=DentistNearMe <onboarding@resend.dev>
# Resend sandbox: onboarding@resend.dev only delivers to your Resend account email.
# Set RESEND_SANDBOX_TO to that address for local testing; remove after domain verification.
RESEND_SANDBOX_TO=your-resend-account@gmail.com
# Where new-booking notifications go (front desk / clinic inbox).
ADMIN_EMAIL=your-clinic@gmail.com

# Public site URL used for reschedule/cancel links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA timezone used to render appointment times in emails.
CLINIC_TIMEZONE=Africa/Lagos

# Secret protecting the reminder cron. Generate one and set the same value in
# Vercel's project env so Vercel Cron can call /api/cron/reminders.
CRON_SECRET=
# How many hours before an appointment the reminder is sent (default 48).
REMINDER_WINDOW_HOURS=48
