# Resend — sign up at https://resend.com, create an API key (starts with re_).
RESEND_API_KEY=
# Verified sender. Use onboarding@resend.dev until your domain is verified.
RESEND_FROM_EMAIL=DentistNearMe <onboarding@resend.dev>
# Resend sandbox: onboarding@resend.dev only delivers to your Resend account email.
# Set this to that address for local testing; remove after you verify your own domain.
